<div class="header">
  <h1 class="header-title"><a href="/">Node.js</a></h1>
  <% if (user) { %>
  <p class="welcome">안녕하세요, <%= user.username %>님!</p>
  <a href="/logout" class="auth-btn" style="background-color: #dc3545"
    >로그아웃</a
  >
  <% } else { %>
  <a href="/login" class="auth-btn">로그인</a>
  <% } %>
</div>
